PORT=3000
NODE_ENV=development

# Development only. Simulates SQL Server metadata/execution without a real database.
# Set to false to use a real local SQL Server (see SQL_* below).
# Never set this to true in production (the app will refuse to start).
MOCK_DATABASE=false

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_MS=90000
GEMINI_MAX_RETRIES=1

# Local SQL Server (mssql). Canonical names are SQL_*.
# Optional aliases also work: DB_SERVER, DB_PORT, DB_NAME, DB_USER, DB_PASSWORD.
SQL_SERVER=localhost
SQL_PORT=1433
SQL_DATABASE=MCPDatabase
SQL_USER=sa
SQL_PASSWORD=YOUR_LOCAL_SQL_SERVER_PASSWORD
# Local Ubuntu / Docker SQL often needs encrypt=false and trustServerCertificate=true.
SQL_ENCRYPT=false
SQL_TRUST_SERVER_CERTIFICATE=true
SQL_CONNECTION_TIMEOUT_MS=15000
SQL_REQUEST_TIMEOUT_MS=30000

# Comma-separated schema-qualified procedure names. Required for procedure access.
ALLOWED_PROCEDURES=dbo.GetLoveableAPIListings,dbo.GetLoveableAPIAgentRoster

# Optional JSON business rules (required params, enums, numeric ranges, min/max pairs)
# Example enums: listing_type must be exactly "sale" or "rental"
BUSINESS_RULES_JSON={"dbo.GetLoveableAPIListings":{"required":["listing_type"],"enums":{"listing_type":["sale","rental"]},"multiValueParams":["propTypes"],"pairs":[{"min":"minBed","max":"maxBed"},{"min":"minSqFt","max":"maxSqFt"}],"ranges":{"minBed":{"min":0,"max":20},"maxBed":{"min":0,"max":20},"minSqFt":{"min":0},"maxSqFt":{"min":0}}}}
METADATA_CACHE_TTL_MS=300000
PROCEDURE_RESULT_MAX_ROWS=500

CORS_ORIGIN=http://localhost:5173
REQUEST_BODY_LIMIT=100kb
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

MCP_SERVER_URL=http://127.0.0.1:3001/mcp
MCP_SERVER_PORT=3001
MCP_BIND_HOST=127.0.0.1
MCP_AUTH_TOKEN=
# Optional. Defaults to (GEMINI_TIMEOUT_MS + buffers) * (1 + GEMINI_MAX_RETRIES).
# Must be greater than Gemini's per-request budget so interpret does not hit MCP -32001 first.
# MCP_TOOL_TIMEOUT_MS=195000

# Required in production for POST /api/execute
API_AUTH_TOKEN=
